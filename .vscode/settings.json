{
    // =====================
    // 🧠 Code Spell Checker
    // =====================
    "cSpell.language": "fr,en",
    "cSpell.enabled": true,
    "cSpell.ignorePaths": [
        "build/**", // Ignore les fichiers compilés
        "*.bib", // Ignore la bibliographie
        "*.aux",
        "*.log",
        "*.out"
    ],
    "cSpell.words": [
        "Lieb",
        "Liniger",
        "Bethe",
        "GHD",
        "rho",
        "dipolaire",
        "hydrodynamique",
        "quantiques"
    ],
    // =====================
    // 📝 LTEX / LanguageTool
    // =====================
    "ltex.enabled": true,
    "ltex.language": "fr",
    "ltex.latex.commands": {
        "\\cite": "ignore",
        "\\ref": "ignore",
        "\\eqref": "ignore",
        "\\textcite": "ignore"
    },
    "ltex.diagnosticSeverity": "information",
    "ltex.additionalRules.enablePickyRules": true,
    "ltex.latex.environments.ignored": [
        "equation",
        "align",
        "tikzpicture",
        "table"
    ],
    // =====================
    // 📄 Améliorations LaTeX
    // =====================
    "files.associations": {
        "*.tex": "latex"
    },
    "editor.wordWrap": "on",
    "editor.spellCheck": true
}